---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-header">
  <div class="container narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(48px, 8vw, 88px) clamp(32px, 5vw, 56px);
    background:
      radial-gradient(1000px 300px at 90% -10%, rgb(10 40 94 / 0.08), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .page-header .container {
    max-width: var(--max);
  }
  .page-header h1,
  .page-header .lead {
    max-width: 760px;
  }
</style>
