---
/**
 * A large circular photo with two smaller overlapping circles, set on a dotted halftone
 * pattern with small accent dots and a ring.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Pic {
  src: ImageMetadata;
  alt: string;
  position?: string;
}
interface Props {
  main: Pic;
  top: Pic;
  bottom: Pic;
}
const { main, top, bottom } = Astro.props;
---

<div class="cluster">
  <span class="halftone" aria-hidden="true"></span>
  <span class="dot dot--red" aria-hidden="true"></span>
  <span class="dot dot--navy" aria-hidden="true"></span>
  <span class="ring" aria-hidden="true"></span>
  <Image class="c c--main" src={main.src} alt={main.alt} widths={[400, 700]} sizes="(max-width: 900px) 70vw, 420px" style={`object-position:${main.position ?? 'center'}`} />
  <Image class="c c--top" src={top.src} alt={top.alt} widths={[240, 400]} sizes="200px" style={`object-position:${top.position ?? 'center'}`} />
  <Image class="c c--bottom" src={bottom.src} alt={bottom.alt} widths={[200, 320]} sizes="150px" style={`object-position:${bottom.position ?? 'center'}`} />
</div>

<style>
  .cluster {
    position: relative;
    width: 100%;
    max-width: 540px;
    aspect-ratio: 1 / 0.92;
    margin-inline: auto;
  }
  .c {
    position: absolute;
    border-radius: 50%;
    object-fit: cover;
    aspect-ratio: 1;
    height: auto;
    box-shadow: 0 14px 34px rgb(10 40 94 / 0.2);
  }
  .c--main {
    width: 66%;
    left: 12%;
    top: 14%;
    border: 6px solid #fff;
  }
  .c--top {
    width: 34%;
    right: 2%;
    top: 8%;
    border: 6px solid #fff;
  }
  .c--bottom {
    width: 25%;
    left: 0;
    bottom: 2%;
    border: 5px solid #fff;
  }
  /* dotted halftone that fades out from the top left */
  .halftone {
    position: absolute;
    inset: 0 30% 18% 0;
    background-image: radial-gradient(circle, rgb(10 40 94 / 0.28) 2px, transparent 2.6px);
    background-size: 13px 13px;
    -webkit-mask-image: radial-gradient(ellipse at 35% 35%, #000 20%, transparent 70%);
    mask-image: radial-gradient(ellipse at 35% 35%, #000 20%, transparent 70%);
  }
  .dot,
  .ring {
    position: absolute;
    border-radius: 50%;
  }
  .dot--red {
    width: 18px;
    height: 18px;
    background: var(--red);
    left: 6%;
    top: 12%;
  }
  .dot--navy {
    width: 12px;
    height: 12px;
    background: var(--navy);
    right: 10%;
    bottom: 26%;
  }
  .ring {
    width: 24px;
    height: 24px;
    border: 3px solid var(--sky);
    left: 54%;
    top: 4%;
  }
</style>
