---
/**
 * One photo seen through a stack of diagonal capsules, with floating accent dots.
 * The capsules are an SVG clip path, so the photo stays a single optimised image.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** SVG preserveAspectRatio alignment, to keep faces in the capsules */
  align?: string;
}
const { src, alt, align = 'xMidYMid' } = Astro.props;
const img = await getImage({ src, width: 1100, format: 'webp' });
const id = `capsules-${Math.random().toString(36).slice(2, 8)}`;

// Capsules in a rotated coordinate space centred on (0, 0): [x, y, width]. Height is fixed.
const h = 128;
const capsules = [
  [-236, -206, 226],
  [6, -206, 174],
  [-292, -64, 204],
  [-70, -64, 290],
  [-214, 78, 236],
  [40, 78, 166],
];
---

<div class="capsule-frame">
  <span class="dot dot--red" aria-hidden="true"></span>
  <span class="dot dot--blue" aria-hidden="true"></span>
  <span class="dot dot--navy" aria-hidden="true"></span>
  <span class="ring" aria-hidden="true"></span>
  <span class="blob" aria-hidden="true"></span>
  <svg viewBox="0 0 640 640" role="img" aria-label={alt}>
    <defs>
      <clipPath id={id}>
        {/* clipPath only accepts shapes, so each capsule carries the rotation itself */}
        {capsules.map(([x, y, w], i) => (
          <rect
            x={x}
            y={y}
            width={w}
            height={h}
            rx={h / 2}
            transform="translate(320 320) rotate(-45)"
            style={`--dx:${i % 2 ? 220 : -220}px;--i:${i}`}
          />
        ))}
      </clipPath>
    </defs>
    <image href={img.src} width="640" height="640" preserveAspectRatio={`${align} slice`} clip-path={`url(#${id})`} />
  </svg>
</div>

<style>
  .capsule-frame {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
  }
  svg {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 18px 30px rgb(10 40 94 / 0.18));
  }
  /* capsules slide in along their length, alternating directions */
  rect {
    transform: translate(320px, 320px) rotate(-45deg);
    animation: capsule-in 1s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }
  @keyframes capsule-in {
    from {
      transform: translate(320px, 320px) rotate(-45deg) translateX(var(--dx));
    }
  }
  .dot,
  .ring,
  .blob {
    animation: pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 0.9s both;
    position: absolute;
    border-radius: 50%;
  }
  .dot--red {
    width: 18px;
    height: 18px;
    background: var(--red);
    top: 44%;
    right: 2%;
    animation:
      pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 0.9s both,
      float 6s ease-in-out 1.5s infinite;
  }
  .dot--blue {
    width: 14px;
    height: 14px;
    background: var(--sky);
    bottom: 12%;
    left: 4%;
    animation:
      pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 1s both,
      float 7s ease-in-out 1.6s infinite reverse;
  }
  .dot--navy {
    width: 10px;
    height: 10px;
    background: var(--navy);
    top: 10%;
    left: 14%;
    animation:
      pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 1.1s both,
      float 5s ease-in-out 1.7s infinite;
  }
  .ring {
    width: 26px;
    height: 26px;
    border: 3px solid var(--sky);
    bottom: 4%;
    right: 26%;
    animation:
      pop 0.6s cubic-bezier(0.3, 1.6, 0.5, 1) 1.2s both,
      pulse 3.2s ease-in-out 1.8s infinite;
  }
  /* soft capsule echoing the logo's red dash, half off the edge */
  .blob {
    width: 64px;
    height: 132px;
    border-radius: 32px;
    background: var(--red);
    top: 2%;
    right: -4%;
    transform: rotate(35deg);
    animation:
      blob-in 0.9s cubic-bezier(0.2, 0.75, 0.2, 1) 0.7s both,
      sway 8s ease-in-out 1.6s infinite;
  }
  @media (max-width: 899px) {
    .blob {
      right: 0;
      width: 44px;
      height: 92px;
    }
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes pulse {
    50% {
      transform: scale(1.25);
      opacity: 0.5;
    }
  }
  @keyframes blob-in {
    from {
      transform: rotate(35deg) translateY(-80px);
      opacity: 0;
    }
  }
  @keyframes sway {
    50% {
      transform: rotate(28deg) translateY(6px);
    }
  }
</style>
