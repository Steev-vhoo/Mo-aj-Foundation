---
/**
 * Shows an optimised image, or a branded placeholder until real photos arrive.
 * Placeholders state what photo belongs there so the foundation can supply it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  ratio?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt = '', label = 'Photo coming soon', ratio = '4 / 3', class: cls, eager = false } = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      class:list={['photo', cls]}
      style={`aspect-ratio:${ratio}`}
      widths={[400, 800, 1200]}
      sizes="(max-width: 900px) 100vw, 50vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    <div class:list={['photo placeholder', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="9" cy="10" r="2" />
        <path d="M21 16l-5-5-8 8" />
      </svg>
      <span>{label}</span>
    </div>
  )
}

<style>
  .photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    color: #9fb0d0;
    font-size: 0.95rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.04) 25%, transparent 25%) 0 0 / 24px 24px,
      linear-gradient(160deg, var(--navy-700), var(--navy-900));
  }
</style>
