---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Help us make every journey a safe one',
  text = 'Your gift supports families who have lost loved ones on our roads and funds our campaigns for safer roads across Ghana.',
} = Astro.props;
---

<section class="section section--navy cta" data-reveal="trigger">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a href="/donate" class="btn btn--primary">Donate now</a>
      <a href="/get-involved" class="btn btn--light">Volunteer</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }
  /* echo of the red dash in the logo */
  .cta::before {
    content: '';
    position: absolute;
    right: -40px;
    top: 50%;
    width: 320px;
    height: 36px;
    border-radius: 18px;
    background: var(--red);
    opacity: 0.12;
    transform: translateY(-50%) rotate(-8deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cta::before {
      translate: 120% 0;
      transition: translate 1.2s cubic-bezier(0.2, 0.75, 0.2, 1) 0.2s;
    }
    :global(.js) .cta.is-in::before {
      translate: 0 0;
    }
  }
  .inner {
    position: relative;
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.6fr auto;
    }
  }
  .lead {
    margin: 0;
    max-width: 60ch;
  }
</style>
