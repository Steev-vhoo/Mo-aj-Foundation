---
import { site } from '../config';

interface Props {
  class?: string;
}

// Simple outline glyphs; only networks with a URL in config are shown.
const icons: Record<string, { label: string; path: string }> = {
  facebook: { label: 'Facebook', path: 'M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v7h4v-7h3l1-4h-4V8z' },
  instagram: {
    label: 'Instagram',
    path: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01',
  },
  x: { label: 'X', path: 'M4 4l16 16M20 4L4 20' },
  linkedin: { label: 'LinkedIn', path: 'M6 9v11M6 5v.01M10 20v-6a3 3 0 0 1 6 0v6M10 9v11M16 20v-6' },
  youtube: {
    label: 'YouTube',
    path: 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8zm7 1v6l5-3-5-3z',
  },
  tiktok: { label: 'TikTok', path: 'M14 3v11a4 4 0 1 1-4-4M14 3a5 5 0 0 0 5 5' },
};

const links = Object.entries(site.social).filter(([, url]) => url);
---

{
  links.length > 0 && (
    <ul class:list={['social', Astro.props.class]}>
      {links.map(([key, url]) => (
        <li>
          <a href={url} target="_blank" rel="noopener" aria-label={icons[key].label}>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[key].path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    list-style: none;
    display: flex;
    gap: 10px;
    padding: 0;
    margin: 0;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    color: inherit;
  }
</style>
