---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  kicker?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { href, title, summary, date, kicker, image, imageAlt } = Astro.props;
const formatted = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="entry">
  <div class="media">
    <Photo src={image} alt={imageAlt} ratio="16 / 10" label="Story photo" />
  </div>
  <div class="body">
    <p class="meta">
      {kicker && <span>{kicker} · </span>}<time datetime={date.toISOString()}>{formatted}</time>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
  </div>
</article>

<style>
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .entry:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgb(10 40 94 / 0.06), 0 18px 40px rgb(10 40 94 / 0.14);
  }
  .entry {
    padding: 10px 10px 0;
  }
  .media {
    border-radius: 18px 18px 34px 34px;
    overflow: hidden;
    isolation: isolate;
  }
  .media :global(.photo) {
    border-radius: 0;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .entry:hover .media :global(.photo) {
    transform: scale(1.06);
  }
  .body {
    padding: 18px 14px 24px;
  }
  .meta {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 6px;
  }
  h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  /* whole card is clickable */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entry:hover h3 a {
    color: var(--red-600);
  }
  p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }
</style>
