---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getNews, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="section">
    <div class="container narrow">
      <a href="/news" class="back">← All news</a>
      <p class="eyebrow">News</p>
      <h1>{entry.data.title}</h1>
      <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
      {entry.data.image && <Photo src={entry.data.image} alt={entry.data.imageAlt} ratio="16 / 9" eager />}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 24px;
    text-decoration: none;
    font-weight: 600;
  }
  .meta {
    color: var(--muted);
  }
  .prose {
    margin-top: 32px;
  }
</style>
