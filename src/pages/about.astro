---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import type { ImageMetadata } from 'astro';
import Photo from '../components/Photo.astro';
import CircleCluster from '../components/CircleCluster.astro';
import CtaBand from '../components/CtaBand.astro';
import crowd from '../assets/gallery/02-guests-gather-for-the-unveiling.jpg';
import tShirt from '../assets/gallery/05-wearing-the-mo-aj-foundation-colours.jpg';
import busShelter from '../assets/gallery/03-the-mo-aj-foundation-bus-shelter.jpg';
import ribbonCutting from '../assets/gallery/01-ribbon-cutting-at-the-bus-shelter-unveiling.jpg';

const ideals = ['Community engagement', 'Educational excellence', 'Financial independence', 'Entrepreneurship', 'Leadership'];

// Group photos: drop images into src/assets/team/. The file name becomes the caption, minus any
// leading number used for ordering: "01-the-family-at-the-unveiling.jpg" → "The family at the unveiling".
const teamFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const groupPhotos = Object.entries(teamFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop()!.replace(/\.\w+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').replace(/\bmo aj( foundation)?\b/gi, (_, f) => (f ? 'MO-AJ Foundation' : 'MO-AJ'));
    return { src: mod.default, caption: name.charAt(0).toUpperCase() + name.slice(1) };
  });

// TODO: replace with the real names and roles once the foundation sends them.
const team = [
  { name: 'Name to be confirmed', role: 'Founder' },
  { name: 'Name to be confirmed', role: 'Trustee' },
  { name: 'Name to be confirmed', role: 'Programmes Lead' },
];
---

<Base title="About us" description="The story, mission and people behind the Mark Ofosu-Ampadu Jnr (MO-AJ) Foundation.">
  <PageHeader
    eyebrow="About us"
    title="Born from loss, built for change"
    lead="The Mark Ofosu-Ampadu Jnr Foundation was founded by the Ofosu-Ampadu family and others of like mind to take a stand on road safety in Ghana."
  />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Our mission</p>
        <h2>A human face to road carnage</h2>
        <p class="lead">
          To put a human face to road carnage in Ghana, telling the stories of road accident victims and their
          families, while galvanising public and stakeholder support to influence road safety policy and
          infrastructure planning and decision-making at the highest levels of leadership.
        </p>
      </div>
      <div class="panel-frame">
        <Photo src={crowd} alt="Family, friends and supporters gathered at a MO-AJ Foundation event" ratio="4 / 3" />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <CircleCluster
        main={{ src: tShirt, alt: "A supporter wearing a MO-AJ Foundation T-shirt printed with Mark's portrait", position: '60% center' }}
        top={{ src: busShelter, alt: "The MO-AJ Foundation bus shelter with Mark's portrait", position: '40% center' }}
        bottom={{ src: ribbonCutting, alt: 'Family and supporters cutting the ribbon', position: '55% center' }}
      />
      <div>
        <p class="eyebrow">Why we exist</p>
        <h2>Remembering Mark</h2>
        <p>
          Mark "Junior" Ofosu-Ampadu died in a road traffic accident on Saturday, 25 January 2020. The accounts
          from the scene convinced his family that Ghana's response to road accidents, and to road safety as a
          whole, was not good enough, and may have contributed to their loss.
        </p>
        <p>
          Out of a year of grief, reflection and family unity came a decision: to turn their pain into a
          vehicle for change, so that others are spared a loss like theirs.
        </p>
        <a href="/stories/marks-story" class="btn btn--navy">Read the family's words</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        <div class="card">
          <h3>Advocacy</h3>
          <p>We bring the human cost of road crashes to the people who make road policy and infrastructure decisions.</p>
        </div>
        <div class="card">
          <h3>Awareness</h3>
          <p>We speak to the public through stories, events and campaigns that make road safety personal.</p>
        </div>
        <div class="card">
          <h3>Family support</h3>
          <p>We walk with families who have lost loved ones on the road, helping them stay productive and hopeful.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <p class="eyebrow">Mark's ideals</p>
      <h2>The values we carry forward</h2>
      <p class="lead">Alongside our road safety work, we celebrate Mark's life by supporting the ideals he held dear.</p>
      <ul class="ideals">
        {ideals.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Our people</p>
      <h2>The team</h2>
      <p class="lead team-lead">The family, friends and volunteers who carry Mark's legacy forward.</p>
      <div class="grid grid--2 groups">
        {
          groupPhotos.length > 0
            ? groupPhotos.map((g, i) => (
                <figure class:list={['panel-frame', { 'is-feature': i === 0 && groupPhotos.length > 2 }]}>
                  <Photo
                    src={g.src}
                    alt={g.caption}
                    ratio={i === 0 && groupPhotos.length > 2 ? '16 / 9' : '3 / 2'}
                    position="center 30%"
                    eager={false}
                  />
                  <figcaption>{g.caption}</figcaption>
                </figure>
              ))
            : [1, 2].map(() => (
                <figure class="panel-frame">
                  <Photo label="Team group photo" ratio="3 / 2" />
                </figure>
              ))
        }
      </div>
      <ul class="names">
        {
          team.map((m) => (
            <li>
              <strong>{m.name}</strong>
              <span>{m.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .ideals {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ideals li {
    padding: 10px 20px;
    border-radius: 999px;
    border: 1.5px solid rgb(255 255 255 / 0.4);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 500;
  }
  .card p {
    margin: 0;
    color: var(--muted);
  }
  .team-lead {
    max-width: 60ch;
    margin-bottom: 32px;
  }
  .groups figure {
    margin: 0;
  }
  /* with three or more photos, the first one spans the full width */
  .groups .is-feature {
    grid-column: 1 / -1;
  }
  .groups figcaption {
    position: relative;
    margin-top: 14px;
    padding-right: 22px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .names {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .names li {
    display: grid;
    padding: 16px 20px;
    border-left: 4px solid var(--red);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    box-shadow: var(--shadow);
  }
  .names strong {
    font-family: var(--font-head);
    color: var(--navy);
  }
  .names span {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
